{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": [
      "react",
      "react-dom",
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "app/page.tsx",
    "app/puzzle.ts",
    "app/application.tsx",
    "app/creator.tsx",
    "app/animation.ts",
    "app/player.tsx",
    "app/studio.tsx",
    "app/site.ts",
    "client.tsx",
    "api/*.ts",
    "server/*.ts"
  ]
}
